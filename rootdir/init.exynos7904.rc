# SPDX-License-Identifier: Apache-2.0
on early-init
    mount debugfs debugfs /sys/kernel/debug

# Vendor init.exynos7904.rc mounts cache, EFS and userdata once on fs.
# Repeating mount_all here causes EBUSY and prevents init's FBE keyring setup.
# The root fstab remains the first-stage source for vendor/product mounts.

on post-fs-data
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/audio 0770 audioserver audio
    mkdir /data/vendor/camera 0770 cameraserver camera
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    restorecon_recursive /data/vendor
