# Android 14 init opens imported files with O_NOFOLLOW. The upstream zygote32
# import is a symlink, so preserve its ARM32 self-test triggers in a regular
# device init file. Service definitions and failure handling remain upstream.
on init && property:ro.product.cpu.abilist32=*
    exec_start boringssl_self_test32

on property:apexd.status=ready && property:ro.product.cpu.abilist32=*
    exec_start boringssl_self_test_apex32
