// Hardware gate only; intentionally absent from PRODUCT_PACKAGES.
cc_library_shared {
    name: "libgta3xlwifi_abi_probe",
    srcs: ["probe.cpp"],
    sdk_version: "28",
    stl: "libc++_static",
    compile_multilib: "both",
    installable: false,
    shared_libs: ["libEGL", "libGLESv2", "libandroid", "liblog"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

android_test_helper_app {
    name: "gta3xlwifi_abi_probe64",
    srcs: ["MainActivity.java"],
    manifest: "Manifest64.xml",
    sdk_version: "current",
    min_sdk_version: "28",
    target_sdk_version: "34",
    compile_multilib: "64",
    jni_libs: ["libgta3xlwifi_abi_probe"],
    use_embedded_native_libs: true,
}

android_test_helper_app {
    name: "gta3xlwifi_abi_probe32",
    srcs: ["MainActivity.java"],
    manifest: "Manifest32.xml",
    sdk_version: "current",
    min_sdk_version: "28",
    target_sdk_version: "34",
    compile_multilib: "32",
    jni_libs: ["libgta3xlwifi_abi_probe"],
    use_embedded_native_libs: true,
}
