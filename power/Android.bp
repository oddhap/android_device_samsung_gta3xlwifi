package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}
cc_library_static {
    name: "libgta3xlwifi_power",
    srcs: ["Power.cpp"],
    export_include_dirs: ["."],
    shared_libs: ["android.hardware.power-V2-cpp", "libbase", "liblog"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    cpp_std: "c++17",
}
cc_test_host {
    name: "gta3xlwifi-power-window-test",
    srcs: ["BoostWindowTest.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    cpp_std: "c++17",
}
