// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["device_samsung_gta3xlwifi_license"],
}

license {
    name: "device_samsung_gta3xlwifi_license",
    license_kinds: ["SPDX-license-identifier-Apache-2.0", "legacy_notice"],
}

// Derived from the upstream P/4.4 profile. Only the five requirements tied to
// the restored legacy networking path differ; all other constraints are kept.
kernel_config {
    name: "kernel_config_gta3xlwifi_p_4.4",
    srcs: [
        "configs/kernel/android-base.config",
        "configs/kernel/android-base-arm.config",
        "configs/kernel/android-base-arm64.config",
    ],
    meta: "configs/kernel/android-base-conditional.xml",
}

// Samsung's unchanged Android 11 vendor advertises FCM level 3. The new
// platform dropped its installation, so retain the Android P HAL contract
// only for this product and continue checking all of its requirements.
vintf_compatibility_matrix {
    name: "framework_compatibility_matrix.gta3xlwifi.3.xml",
    stem: "compatibility_matrix.3.xml",
    srcs: ["configs/framework_matrix.3.xml"],
    kernel_configs: ["kernel_config_gta3xlwifi_p_4.4"],
}

// The unchanged Samsung vendor matrix retains its original SDK 28 contract.
// Vendor APKs are resource-only overlays; native HALs use the VNDK 30 snapshot.
prebuilt_etc {
    name: "gta3xlwifi_framework_legacy_sdk_manifest",
    src: "configs/framework_manifest.legacy_sdk.xml",
    filename: "gta3xlwifi-legacy-sdk.xml",
    sub_dir: "vintf/manifest",
}

// Make's PRODUCT_FORCE_PRODUCT_MODULES_TO_SYSTEM_PARTITION does not change
// Soong install paths or apkcerts metadata. Keep all three selected APKs on
// system for this fixed-partition product, without changing their certificates.
// Other products retain the original product partition placement.
soong_config_module_type {
    name: "gta3xlwifi_partition_java_defaults",
    module_type: "java_defaults",
    config_namespace: "gta3xlwifi",
    bool_variables: ["system_apps"],
    properties: ["product_specific"],
}

gta3xlwifi_partition_java_defaults {
    name: "gta3xlwifi_partition_app_defaults",
    defaults_visibility: [
        "//external/chromium-webview:__pkg__",
        "//packages/apps/Backgrounds:__pkg__",
        "//packages/screensavers/PhotoTable:__pkg__",
    ],
    soong_config_variables: {
        system_apps: {
            product_specific: false,
            conditions_default: {
                product_specific: true,
            },
        },
    },
}
